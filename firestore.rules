rules_version = '2';

// ===============================================================
// Assumed Marketplace Data Model (prototype, 2026-10-17)
// ===============================================================
//
// This section documents only the new Marketplace collections. The legacy
// Nubify collections below retain their existing rules for compatibility.
//
// marketplaceProducts/{listingId}
//   listingId: string (required, immutable, equals document id)
//   sellerId: string (required, immutable, authenticated owner)
//   sellerName: string (required, 1-120 characters when published)
//   sellerPhotoUrl: string (required, empty or HTTPS URL, max 2048)
//   title: string (required, max 120; non-empty when published)
//   description: string (required, max 5000)
//   category: string (required; one of the twelve stable category ids)
//   condition: string (required; new, used, or service when published)
//   priceType: string (required; fixed, negotiable, free, or contact)
//   price: number (required, 0-100,000,000 EGP)
//   currency: string (required, EGP)
//   media: list (required, max 5 strictly validated media maps)
//   mediaCount: integer (required, exactly media.size())
//   coverMediaIndex: integer (required, -1 only when media is empty)
//   thumbnailUrl: string (required, empty or HTTPS URL, max 2048)
//   status: string (required; draft, available, sold, unavailable, archived)
//   publicVisible: bool (required; true only for available listings)
//   contactPreferences: map (required; allowMessages/allowCalls booleans)
//   searchPrefixes: list (required, max 20 strings, each max 64)
//   createdAt/updatedAt: timestamp (required; createdAt immutable)
//   publishedAt/soldAt/unavailableAt/archivedAt: timestamp or null (required)
//
// marketplaceSellerStats/{uid}
//   sellerId, sellerName, sellerPhotoUrl, availableListingCount, active,
//   updatedAt
//   (server-maintained; authenticated read only)
//
// marketplaceCategoryStats/{categoryId}
//   category, availableListingCount, updatedAt
//   (server-maintained; authenticated read only)
//
// marketplaceReports/{reportId}
//   reportId, reporterId, listingId, sellerId, reason, explanation, status,
//   createdAt, updatedAt, reviewedAt, reviewedBy, resolutionNote
//
// marketplaceAdminAudit/{eventId}
//   actorUid, action, targetUid, details, createdAt
//   (server-maintained, reviewer-readable only)
//
// userPrivate/{uid}
//   uid, phoneE164, allowMarketplaceCalls, createdAt, updatedAt
//   (owner-only; never publicly readable)
//
// users/{uid}/savedMarketplaceListings/{listingId}
//   listingId, ownerUid, savedAt (owner-only)
//
// Reviewer authority is derived only from Firebase Authentication custom
// claims: marketplaceOwner, admin, moderator, or marketplaceReviewer.
// Editable profile fields are never trusted for Marketplace authorization.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
  //===================================================
// LINK PREVIEW CACHE
//===================================================

match /linkPreviews/{previewId} {
  allow read: if request.auth != null;

  allow create, update, delete: if false;
}
  //===============================
// HELPER
//===============================

function signedIn() {
  return request.auth != null;
}

//===============================
// DIRECT CONVERSATIONS
//===============================

match /conversations/{conversationId} {

  allow create: if signedIn()
    && request.resource.data.participants is list
    && request.auth.uid
        in request.resource.data.participants;

  allow read: if signedIn()
    && request.auth.uid
        in resource.data.participants;

  allow update: if signedIn()
    && request.auth.uid
        in resource.data.participants
    && request.resource.data.participants
        == resource.data.participants;

  //===============================
  // DIRECT MESSAGES
  //===============================

  match /messages/{messageId} {

    allow create: if signedIn()
      && request.resource.data.senderId
          == request.auth.uid
      && request.auth.uid
          in getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

    allow read: if signedIn()
      && request.auth.uid
          in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

    allow update: if signedIn()
      && request.auth.uid
          in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;
  }

  //===============================
  // TYPING
  //===============================

  match /typing/{userId} {
    allow read: if signedIn();

    allow write: if signedIn()
      && request.auth.uid == userId;
  }

  //===============================
  // RECORDING
  //===============================

  match /recording/{userId} {
    allow read: if signedIn();

    allow write: if signedIn()
      && request.auth.uid == userId;
  }
}

//===============================
// CHAT PRIVACY
//===============================

match /users/{userId}/chatSettings/{settingId} {

  allow read: if signedIn();

  allow create, update, delete:
      if signedIn()
      && request.auth.uid == userId;
}

//===============================
// BLOCKED USERS
//===============================

match /users/{userId}/blockedUsers/{blockedUserId} {

  allow read, create, update, delete:
      if signedIn()
      && request.auth.uid == userId;
}

//===============================
// PRESENCE
//===============================

match /userPresence/{userId} {

  allow read:
      if signedIn();

  allow create, update:
      if signedIn()
      && request.auth.uid == userId;
}

//===============================
// GROUPS
//===============================

match /chatGroups/{groupId} {

  //===============================
  // CREATE GROUP
  //===============================

  allow create: if signedIn()
    && request.resource.data.creatorId
        == request.auth.uid
    && request.auth.uid
        in request.resource.data.memberIds
    && request.auth.uid
        in request.resource.data.adminIds;

  //===============================
  // READ GROUP
  //===============================

  allow read: if signedIn()
    && request.auth.uid
        in resource.data.memberIds;

  //===============================
  // UPDATE GROUP
  //===============================

  allow update: if signedIn()
    && (
      request.auth.uid
          in resource.data.adminIds

      ||

      (
        request.auth.uid
            in resource.data.memberIds

        && resource.data.permissions
            .membersCanEditGroupSettings == true

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'description',
              'photoUrl',
              'updatedAt'
            ])
      )

      ||

      (
        request.auth.uid
            in resource.data.memberIds

        && resource.data.permissions
            .membersCanAddMembers == true

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'memberIds',
              'members',
              'memberJoinedAt',
              'updatedAt'
            ])
      )

      ||

      (
        request.auth.uid
            in resource.data.memberIds

        && !(request.auth.uid
            in request.resource.data.memberIds)

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'memberIds',
              'members',
              'adminIds',
              'memberJoinedAt',
              'updatedAt'
            ])
      )
    );

  //===============================
  // GROUP MESSAGES
  //===============================

  match /messages/{messageId} {

    allow read: if signedIn()
      && request.auth.uid
          in get(
            /databases/$(database)/documents/chatGroups/$(groupId)
          ).data.memberIds;

    allow create: if signedIn()
      && request.resource.data.senderId
          == request.auth.uid

      && request.auth.uid
          in get(
            /databases/$(database)/documents/chatGroups/$(groupId)
          ).data.memberIds

      && (
        request.auth.uid
            in get(
              /databases/$(database)/documents/chatGroups/$(groupId)
            ).data.adminIds

        ||

        get(
          /databases/$(database)/documents/chatGroups/$(groupId)
        ).data.permissions.membersCanSendMessages == true
      );

    allow update: if signedIn()
      && request.auth.uid
          in get(
            /databases/$(database)/documents/chatGroups/$(groupId)
          ).data.memberIds;
  }

  //===================================================
  // SECURE GROUP JOIN REQUESTS
  //===================================================

  match /joinRequests/{userId} {

    // Join requests are created through the
    // authenticated Firebase Cloud Function.
    //
    // Clients cannot forge invitations or
    // submit requests directly.

    allow create: if false;

    // Only group admins can review,
    // approve, reject, or remove requests.

    allow read, update, delete:
        if signedIn()
        && request.auth.uid
            in get(
              /databases/$(database)/documents/chatGroups/$(groupId)
            ).data.adminIds;
  }
}

//===============================
// AUDIO CALLS
//===============================

match /calls/{callId} {

  allow create: if signedIn()
    && request.resource.data.callerId
        == request.auth.uid;

  allow read, update: if signedIn()
    && (
      request.auth.uid
          == resource.data.callerId

      ||

      request.auth.uid
          == resource.data.calleeId
    );

  match /callerCandidates/{candidateId} {

    allow read, write: if signedIn()
      && (
        request.auth.uid
            == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId

        ||

        request.auth.uid
            == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId
      );
  }

  match /calleeCandidates/{candidateId} {

    allow read, write: if signedIn()
      && (
        request.auth.uid
            == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId

        ||

        request.auth.uid
            == get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId
      );
  }
}

    //===================================================
    // COMMON HELPERS
    //===================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() &&
          request.auth.uid == uid;
    }

    function changedOnly(fields) {
      return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(fields);
    }

    //===================================================
    // MARKETPLACE SECURITY HELPERS
    //===================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() &&
          request.auth.uid == uid;
    }

    // Used by owner-scoped documents whose identity field is named `uid`.
    function uidUnchanged(data) {
      return isAuthenticated() &&
          data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid ==
          resource.data.uid;
    }

    function isMarketplaceReviewer() {
      return isAuthenticated() &&
          (
            request.auth.token.get('admin', false) == true ||
            request.auth.token.get('moderator', false) == true ||
            request.auth.token.get('marketplaceReviewer', false) == true ||
            request.auth.token.get('marketplaceOwner', false) == true
          );
    }

    function marketplaceHasSafeListLimit(maximum) {
      return request.query.limit != null &&
          request.query.limit > 0 &&
          request.query.limit <= maximum;
    }

    function marketplaceValidId(value) {
      return value is string &&
          value.size() >= 1 &&
          value.size() <= 128 &&
          value.matches('^[A-Za-z0-9_-]+$');
    }

    function marketplaceValidRequiredString(value, minimum, maximum) {
      return value is string &&
          value.size() >= minimum &&
          value.size() <= maximum;
    }

    function marketplaceValidOptionalString(value, maximum) {
      return value is string &&
          value.size() <= maximum;
    }

    function marketplaceValidHttpsUrl(value, allowEmpty) {
      return value is string &&
          value.size() <= 2048 &&
          (
            (allowEmpty && value == '') ||
            value.matches('^https://.+$')
          );
    }

    function marketplaceNullOrTimestamp(data, field) {
      return data.get(field, null) == null ||
          data[field] is timestamp;
    }

    function marketplaceValidListingStatus(status) {
      return status in [
        'draft',
        'available',
        'sold',
        'unavailable',
        'archived'
      ];
    }

    function marketplaceValidCategory(category) {
      return category in [
        'rent_housing',
        'food_snacks',
        'electrical_gadgets',
        'textbooks_books',
        'medical_laboratory',
        'printing_photocopying',
        'clothes_fashion',
        'furniture_room',
        'watches_accessories',
        'student_services',
        'beauty_personal_care',
        'other'
      ];
    }

    function marketplaceValidCondition(condition) {
      return condition in ['new', 'used', 'service'];
    }

    function marketplaceValidPriceType(priceType) {
      return priceType in ['fixed', 'negotiable', 'free', 'contact'];
    }

    function marketplaceValidPrice(data) {
      return (data.price == null || data.price is number) &&
          (
            (
              data.priceType in ['fixed', 'negotiable'] &&
              data.price is number &&
              data.price > 0 &&
              data.price <= 100000000
            ) ||
            (
              data.priceType in ['free', 'contact'] &&
              (
                data.price == null ||
                data.price == 0
              )
            ) ||
            (
              data.status == 'draft' &&
              (
                data.price == null ||
                (
                  data.price >= 0 &&
                  data.price <= 100000000
                )
              ) &&
              (
                data.priceType == '' ||
                marketplaceValidPriceType(data.priceType)
              )
            )
          );
    }

    function marketplaceValidContactPreferences(value) {
      return value is map &&
          value.keys().hasOnly([
            'allowMessages',
            'allowCalls'
          ]) &&
          value.keys().hasAll([
            'allowMessages',
            'allowCalls'
          ]) &&
          value.allowMessages is bool &&
          value.allowCalls is bool;
    }

    function marketplaceValidSearchPrefix(value) {
      return value is string &&
          value.size() >= 1 &&
          value.size() <= 64;
    }

    // Firestore Rules has no list loop. Because searchPrefixes is capped at
    // twenty items, every possible element is explicitly validated.
    function marketplaceValidSearchPrefixes(values) {
      return values is list &&
          values.size() <= 20 &&
          (values.size() < 1 || marketplaceValidSearchPrefix(values[0])) &&
          (values.size() < 2 || marketplaceValidSearchPrefix(values[1])) &&
          (values.size() < 3 || marketplaceValidSearchPrefix(values[2])) &&
          (values.size() < 4 || marketplaceValidSearchPrefix(values[3])) &&
          (values.size() < 5 || marketplaceValidSearchPrefix(values[4])) &&
          (values.size() < 6 || marketplaceValidSearchPrefix(values[5])) &&
          (values.size() < 7 || marketplaceValidSearchPrefix(values[6])) &&
          (values.size() < 8 || marketplaceValidSearchPrefix(values[7])) &&
          (values.size() < 9 || marketplaceValidSearchPrefix(values[8])) &&
          (values.size() < 10 || marketplaceValidSearchPrefix(values[9])) &&
          (values.size() < 11 || marketplaceValidSearchPrefix(values[10])) &&
          (values.size() < 12 || marketplaceValidSearchPrefix(values[11])) &&
          (values.size() < 13 || marketplaceValidSearchPrefix(values[12])) &&
          (values.size() < 14 || marketplaceValidSearchPrefix(values[13])) &&
          (values.size() < 15 || marketplaceValidSearchPrefix(values[14])) &&
          (values.size() < 16 || marketplaceValidSearchPrefix(values[15])) &&
          (values.size() < 17 || marketplaceValidSearchPrefix(values[16])) &&
          (values.size() < 18 || marketplaceValidSearchPrefix(values[17])) &&
          (values.size() < 19 || marketplaceValidSearchPrefix(values[18])) &&
          (values.size() < 20 || marketplaceValidSearchPrefix(values[19]));
    }

    function marketplaceValidStoragePath(path, sellerId, listingId) {
      return path is string &&
          path.size() >= 1 &&
          path.size() <= 512 &&
          path.matches(
            '^marketplace/' + sellerId + '/' + listingId +
            '/[A-Za-z0-9_.-]{1,180}$'
          );
    }

    function marketplaceValidMediaItem(item, sellerId, listingId) {
      return item is map &&
          item.keys().hasOnly([
            'type',
            'url',
            'thumbnailUrl',
            'durationMs',
            'displayOrder',
            'storagePath'
          ]) &&
          item.keys().hasAll([
            'type',
            'url',
            'thumbnailUrl',
            'durationMs',
            'displayOrder',
            'storagePath'
          ]) &&
          item.type in ['image', 'video'] &&
          marketplaceValidHttpsUrl(item.url, false) &&
          marketplaceValidHttpsUrl(item.thumbnailUrl, item.type == 'image') &&
          item.durationMs is int &&
          item.durationMs >= 0 &&
          item.durationMs <= 600000 &&
          item.displayOrder is int &&
          item.displayOrder >= 0 &&
          item.displayOrder <= 4 &&
          marketplaceValidStoragePath(
            item.storagePath,
            sellerId,
            listingId
          );
    }

    // The five-item cap lets us inspect each media map instead of trusting
    // only the outer list type.
    function marketplaceValidMediaList(values, sellerId, listingId) {
      return values is list &&
          values.size() <= 5 &&
          (
            values.size() < 1 ||
            marketplaceValidMediaItem(values[0], sellerId, listingId)
          ) &&
          (
            values.size() < 2 ||
            marketplaceValidMediaItem(values[1], sellerId, listingId)
          ) &&
          (
            values.size() < 3 ||
            marketplaceValidMediaItem(values[2], sellerId, listingId)
          ) &&
          (
            values.size() < 4 ||
            marketplaceValidMediaItem(values[3], sellerId, listingId)
          ) &&
          (
            values.size() < 5 ||
            marketplaceValidMediaItem(values[4], sellerId, listingId)
          );
    }

    function marketplaceListingOwner(data) {
      return isOwner(data.sellerId);
    }

    function marketplaceListingIdentityMatchesProfile(data) {
      let profilePath = /databases/$(database)/documents/users/$(data.sellerId);

      return exists(profilePath) &&
          (
            data.sellerName == get(profilePath).data.get('fullName', '') ||
            data.sellerName == get(profilePath).data.get('username', '') ||
            (
              data.sellerName == '' &&
              get(profilePath).data.get('fullName', null) == null
            )
          ) &&
          (
            data.sellerPhotoUrl == get(profilePath).data.get('photoUrl', '') ||
            (
              data.sellerPhotoUrl == '' &&
              get(profilePath).data.get('photoUrl', null) == null
            )
          );
    }

    function marketplaceValidListingTimestamps(data) {
      return data.createdAt is timestamp &&
          data.updatedAt is timestamp &&
          marketplaceNullOrTimestamp(data, 'publishedAt') &&
          marketplaceNullOrTimestamp(data, 'soldAt') &&
          marketplaceNullOrTimestamp(data, 'unavailableAt') &&
          marketplaceNullOrTimestamp(data, 'archivedAt') &&
          (
            data.status != 'draft' ||
            (
              data.publishedAt == null &&
              data.soldAt == null &&
              data.unavailableAt == null &&
              data.archivedAt == null
            )
          ) &&
          (
            data.status != 'available' ||
            (
              data.publishedAt is timestamp &&
              data.soldAt == null &&
              data.unavailableAt == null &&
              data.archivedAt == null
            )
          ) &&
          (
            data.status != 'sold' ||
            (
              data.publishedAt is timestamp &&
              data.soldAt is timestamp &&
              data.unavailableAt == null &&
              data.archivedAt == null
            )
          ) &&
          (
            data.status != 'unavailable' ||
            (
              data.publishedAt is timestamp &&
              data.soldAt == null &&
              data.unavailableAt is timestamp &&
              data.archivedAt == null
            )
          ) &&
          (
            data.status != 'archived' ||
            data.archivedAt is timestamp
          );
    }

    function marketplaceValidListing(data, listingId) {
      return data.keys().hasOnly([
            'listingId',
            'sellerId',
            'sellerName',
            'sellerPhotoUrl',
            'title',
            'description',
            'category',
            'condition',
            'priceType',
            'price',
            'currency',
            'media',
            'mediaCount',
            'coverMediaIndex',
            'thumbnailUrl',
            'status',
            'publicVisible',
            'contactPreferences',
            'searchPrefixes',
            'createdAt',
            'updatedAt',
            'publishedAt',
            'soldAt',
            'unavailableAt',
            'archivedAt'
          ]) &&
          data.keys().hasAll([
            'listingId',
            'sellerId',
            'sellerName',
            'sellerPhotoUrl',
            'title',
            'description',
            'category',
            'condition',
            'priceType',
            'price',
            'currency',
            'media',
            'mediaCount',
            'coverMediaIndex',
            'thumbnailUrl',
            'status',
            'publicVisible',
            'contactPreferences',
            'searchPrefixes',
            'createdAt',
            'updatedAt',
            'publishedAt',
            'soldAt',
            'unavailableAt',
            'archivedAt'
          ]) &&
          marketplaceValidId(data.listingId) &&
          data.listingId == listingId &&
          marketplaceValidId(data.sellerId) &&
          marketplaceValidOptionalString(data.sellerName, 120) &&
          marketplaceValidHttpsUrl(data.sellerPhotoUrl, true) &&
          marketplaceValidOptionalString(data.title, 120) &&
          marketplaceValidOptionalString(data.description, 5000) &&
          data.category is string &&
          data.category.size() <= 80 &&
          data.condition is string &&
          data.condition.size() <= 16 &&
          data.priceType is string &&
          data.priceType.size() <= 16 &&
          data.currency == 'EGP' &&
          marketplaceValidPrice(data) &&
          marketplaceValidMediaList(data.media, data.sellerId, listingId) &&
          data.mediaCount is int &&
          data.mediaCount == data.media.size() &&
          data.coverMediaIndex is int &&
          (
            (
              data.mediaCount == 0 &&
              data.coverMediaIndex == -1
            ) ||
            (
              data.mediaCount > 0 &&
              data.coverMediaIndex >= 0 &&
              data.coverMediaIndex < data.mediaCount
            )
          ) &&
          marketplaceValidHttpsUrl(data.thumbnailUrl, true) &&
          marketplaceValidListingStatus(data.status) &&
          data.publicVisible is bool &&
          data.publicVisible == (data.status == 'available') &&
          marketplaceValidContactPreferences(data.contactPreferences) &&
          marketplaceValidSearchPrefixes(data.searchPrefixes) &&
          marketplaceValidListingTimestamps(data) &&
          (
            data.status == 'draft' ||
            (
              marketplaceValidRequiredString(data.sellerName, 1, 120) &&
              marketplaceValidRequiredString(data.title, 1, 120) &&
              marketplaceValidCategory(data.category) &&
              marketplaceValidCondition(data.condition) &&
              marketplaceValidPriceType(data.priceType) &&
              data.mediaCount >= 1 &&
              marketplaceValidHttpsUrl(data.thumbnailUrl, false) &&
              data.searchPrefixes.size() >= 1
            )
          );
    }

    function marketplaceValidListingCreate(data, listingId) {
      return marketplaceValidListing(data, listingId) &&
          marketplaceListingOwner(data) &&
          marketplaceListingIdentityMatchesProfile(data) &&
          data.createdAt == request.time &&
          data.updatedAt == request.time &&
          (
            (
              data.status == 'draft' &&
              data.publicVisible == false
            ) ||
            (
              data.status == 'available' &&
              data.publishedAt == request.time
            )
          );
    }

    function marketplaceValidListingTransition() {
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;

      return (
            oldStatus == newStatus &&
            request.resource.data.publishedAt == resource.data.publishedAt &&
            request.resource.data.soldAt == resource.data.soldAt &&
            request.resource.data.unavailableAt == resource.data.unavailableAt &&
            request.resource.data.archivedAt == resource.data.archivedAt
          ) ||
          (
            oldStatus == 'draft' &&
            newStatus == 'available' &&
            request.resource.data.publishedAt == request.time &&
            request.resource.data.soldAt == null &&
            request.resource.data.unavailableAt == null &&
            request.resource.data.archivedAt == null
          ) ||
          (
            oldStatus == 'available' &&
            newStatus == 'sold' &&
            request.resource.data.publishedAt == resource.data.publishedAt &&
            request.resource.data.soldAt == request.time
          ) ||
          (
            oldStatus == 'available' &&
            newStatus == 'unavailable' &&
            request.resource.data.publishedAt == resource.data.publishedAt &&
            request.resource.data.unavailableAt == request.time
          ) ||
          (
            oldStatus in ['draft', 'available', 'unavailable', 'sold'] &&
            newStatus == 'archived' &&
            request.resource.data.publishedAt == resource.data.publishedAt &&
            request.resource.data.soldAt == resource.data.soldAt &&
            request.resource.data.unavailableAt == resource.data.unavailableAt &&
            request.resource.data.archivedAt == request.time
          ) ||
          (
            oldStatus == 'unavailable' &&
            newStatus == 'available' &&
            request.resource.data.publishedAt == request.time &&
            request.resource.data.soldAt == null &&
            request.resource.data.unavailableAt == null &&
            request.resource.data.archivedAt == null
          ) ||
          (
            oldStatus == 'archived' &&
            newStatus == 'available' &&
            request.resource.data.publishedAt == request.time &&
            request.resource.data.soldAt == null &&
            request.resource.data.unavailableAt == null &&
            request.resource.data.archivedAt == null
          ) ||
          (
            oldStatus == 'archived' &&
            newStatus == 'draft' &&
            request.resource.data.publishedAt == null &&
            request.resource.data.soldAt == null &&
            request.resource.data.unavailableAt == null &&
            request.resource.data.archivedAt == null
          );
    }

    function marketplaceValidListingUpdate(data, listingId) {
      return marketplaceValidListing(data, listingId) &&
          marketplaceListingOwner(resource.data) &&
          marketplaceListingIdentityMatchesProfile(data) &&
          data.listingId == resource.data.listingId &&
          data.sellerId == resource.data.sellerId &&
          data.createdAt == resource.data.createdAt &&
          data.updatedAt == request.time &&
          marketplaceValidListingTransition();
    }

    function marketplaceIsPublicListing(data) {
      return data.status == 'available' &&
          data.publicVisible == true;
    }

    // Read-only compatibility for an individual old share/deep-link document.
    // Legacy collection queries remain disallowed because they did not filter
    // availability and could reveal sold/unavailable items.
    function marketplaceIsLegacyPublicListing(data) {
      return !data.keys().hasAll(['status', 'publicVisible']) &&
          data.get('isAvailable', false) == true &&
          data.get('sold', true) == false;
    }

    function marketplaceValidPrivateUser(data, uid) {
      return data.keys().hasOnly([
            'uid',
            'phoneE164',
            'allowMarketplaceCalls',
            'createdAt',
            'updatedAt'
          ]) &&
          data.keys().hasAll([
            'uid',
            'phoneE164',
            'allowMarketplaceCalls',
            'createdAt',
            'updatedAt'
          ]) &&
          data.uid == uid &&
          marketplaceValidId(data.uid) &&
          data.phoneE164 is string &&
          (
            data.phoneE164 == '' ||
            data.phoneE164.matches('^[+]20(10|11|12|15)[0-9]{8}$')
          ) &&
          data.allowMarketplaceCalls is bool &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
    }

    function marketplaceValidPrivateUserCreate(data, uid) {
      return isOwner(uid) &&
          uidUnchanged(data) &&
          marketplaceValidPrivateUser(data, uid) &&
          data.createdAt == request.time &&
          data.updatedAt == request.time;
    }

    function marketplaceValidPrivateUserUpdate(data, uid) {
      return isOwner(uid) &&
          uidNotModified() &&
          marketplaceValidPrivateUser(data, uid) &&
          data.createdAt == resource.data.createdAt &&
          data.updatedAt == request.time;
    }

    function marketplaceValidSavedMarker(data, uid, listingId) {
      return data.keys().hasOnly([
            'listingId',
            'ownerUid',
            'savedAt'
          ]) &&
          data.keys().hasAll([
            'listingId',
            'ownerUid',
            'savedAt'
          ]) &&
          data.listingId == listingId &&
          marketplaceValidId(data.listingId) &&
          data.ownerUid == uid &&
          marketplaceValidId(data.ownerUid) &&
          data.savedAt is timestamp;
    }

    function marketplaceValidSavedListing(data, uid, listingId) {
      return marketplaceValidSavedMarker(data, uid, listingId) &&
          data.savedAt == request.time;
    }

    function marketplaceSavedTargetIsPublic(listingId) {
      return exists(
            /databases/$(database)/documents/marketplaceProducts/$(listingId)
          ) &&
          marketplaceIsPublicListing(
            get(
              /databases/$(database)/documents/marketplaceProducts/$(listingId)
            ).data
          );
    }

    function marketplaceHasOwnedSavedMarker(listingId) {
      let markerPath = /databases/$(database)/documents/users/$(request.auth.uid)/savedMarketplaceListings/$(listingId);

      return isAuthenticated() &&
          exists(markerPath) &&
          marketplaceValidSavedMarker(
            get(markerPath).data,
            request.auth.uid,
            listingId
          );
    }

    function marketplaceIsSavedUnavailableListing(data, listingId) {
      return data.keys().hasAll([
            'listingId',
            'status',
            'publicVisible'
          ]) &&
          data.listingId == listingId &&
          data.status in ['sold', 'unavailable', 'archived'] &&
          data.publicVisible == false &&
          marketplaceHasOwnedSavedMarker(listingId);
    }

    function marketplaceValidReportReason(reason) {
      return reason in [
        'Scam or Fraud',
        'Misleading Information',
        'Prohibited Item',
        'Inappropriate Content',
        'Duplicate Listing',
        'Other'
      ];
    }

    function marketplaceValidReportStatus(status) {
      return status in [
        'submitted',
        'reviewing',
        'resolved',
        'dismissed'
      ];
    }

    function marketplaceValidReport(data, reportId) {
      return data.keys().hasOnly([
            'reportId',
            'reporterId',
            'listingId',
            'sellerId',
            'reason',
            'explanation',
            'status',
            'createdAt',
            'updatedAt',
            'reviewedAt',
            'reviewedBy',
            'resolutionNote'
          ]) &&
          data.keys().hasAll([
            'reportId',
            'reporterId',
            'listingId',
            'sellerId',
            'reason',
            'explanation',
            'status',
            'createdAt',
            'updatedAt',
            'reviewedAt',
            'reviewedBy',
            'resolutionNote'
          ]) &&
          data.reportId == reportId &&
          marketplaceValidRequiredString(data.reportId, 3, 260) &&
          marketplaceValidId(data.reporterId) &&
          marketplaceValidId(data.listingId) &&
          marketplaceValidId(data.sellerId) &&
          marketplaceValidReportReason(data.reason) &&
          marketplaceValidOptionalString(data.explanation, 1000) &&
          marketplaceValidReportStatus(data.status) &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp &&
          marketplaceNullOrTimestamp(data, 'reviewedAt') &&
          marketplaceValidOptionalString(data.reviewedBy, 128) &&
          marketplaceValidOptionalString(data.resolutionNote, 1000) &&
          (
            data.status != 'submitted' ||
            (
              data.reviewedAt == null &&
              data.reviewedBy == '' &&
              data.resolutionNote == ''
            )
          ) &&
          (
            data.status != 'reviewing' ||
            (
              data.reviewedAt is timestamp &&
              marketplaceValidRequiredString(data.reviewedBy, 1, 128)
            )
          ) &&
          (
            !(data.status in ['resolved', 'dismissed']) ||
            (
              data.reviewedAt is timestamp &&
              marketplaceValidRequiredString(data.reviewedBy, 1, 128) &&
              marketplaceValidRequiredString(data.resolutionNote, 1, 1000)
            )
          );
    }

    function marketplaceReportIdFor(reporterId, listingId) {
      return reporterId + '_' + listingId;
    }

    // reportListing() checks the deterministic document before creating it.
    // This helper is used only for a path that does not exist yet. Existing
    // documents are authorized from their stored reporterId below, so a UID
    // prefix collision can never reveal another reporter's document contents.
    function marketplaceReportPathMatchesCaller(reportId) {
      return marketplaceValidId(request.auth.uid) &&
          reportId is string &&
          reportId.size() >= 3 &&
          reportId.size() <= 257 &&
          reportId.matches(
            '^' + request.auth.uid + '_[A-Za-z0-9_-]{1,128}$'
          );
    }

    function marketplaceReportMatchesListing(data) {
      return exists(
            /databases/$(database)/documents/marketplaceProducts/$(data.listingId)
          ) &&
          marketplaceIsPublicListing(
            get(
              /databases/$(database)/documents/marketplaceProducts/$(data.listingId)
            ).data
          ) &&
          get(
            /databases/$(database)/documents/marketplaceProducts/$(data.listingId)
          ).data.sellerId == data.sellerId;
    }

    function marketplaceValidReportCreate(data, reportId) {
      return marketplaceValidReport(data, reportId) &&
          data.reporterId == request.auth.uid &&
          data.reportId == marketplaceReportIdFor(
            request.auth.uid,
            data.listingId
          ) &&
          data.sellerId != request.auth.uid &&
          data.status == 'submitted' &&
          (
            data.reason != 'Other' ||
            marketplaceValidRequiredString(data.explanation, 1, 1000)
          ) &&
          data.createdAt == request.time &&
          data.updatedAt == request.time &&
          data.reviewedAt == null &&
          data.reviewedBy == '' &&
          data.resolutionNote == '' &&
          marketplaceReportMatchesListing(data);
    }

    function marketplaceValidReportTransition(oldStatus, newStatus) {
      return (
            oldStatus == 'submitted' &&
            newStatus in ['reviewing', 'resolved', 'dismissed']
          ) ||
          (
            oldStatus == 'reviewing' &&
            newStatus in ['resolved', 'dismissed']
          );
    }

    function marketplaceValidReportReview(data, reportId) {
      return isMarketplaceReviewer() &&
          marketplaceValidReport(data, reportId) &&
          data.reportId == resource.data.reportId &&
          data.reporterId == resource.data.reporterId &&
          data.listingId == resource.data.listingId &&
          data.sellerId == resource.data.sellerId &&
          data.reason == resource.data.reason &&
          data.explanation == resource.data.explanation &&
          data.createdAt == resource.data.createdAt &&
          marketplaceValidReportTransition(
            resource.data.status,
            data.status
          ) &&
          data.updatedAt == request.time &&
          data.reviewedAt == request.time &&
          data.reviewedBy == request.auth.uid &&
          request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'updatedAt',
                'reviewedAt',
                'reviewedBy',
                'resolutionNote'
              ]);
    }

    function marketplaceValidSellerStats(data, uid) {
      return data.keys().hasOnly([
            'sellerId',
            'sellerName',
            'sellerPhotoUrl',
            'availableListingCount',
            'active',
            'updatedAt'
          ]) &&
          data.keys().hasAll([
            'sellerId',
            'updatedAt'
          ]) &&
          data.sellerId == uid &&
          marketplaceValidId(data.sellerId) &&
          (
            !('sellerName' in data) ||
            marketplaceValidOptionalString(data.sellerName, 100)
          ) &&
          (
            !('sellerPhotoUrl' in data) ||
            marketplaceValidHttpsUrl(data.sellerPhotoUrl, true)
          ) &&
          (
            !('availableListingCount' in data) ||
            (
              data.availableListingCount is int &&
              data.availableListingCount >= 0 &&
              data.availableListingCount <= 1000000
            )
          ) &&
          (
            !('active' in data) ||
            (
              data.active is bool &&
              (
                data.active == false ||
                data.get('availableListingCount', 0) > 0
              )
            )
          ) &&
          data.updatedAt is timestamp;
    }

    function marketplaceValidCategoryStats(data, categoryId) {
      return data.keys().hasOnly([
            'category',
            'availableListingCount',
            'updatedAt'
          ]) &&
          data.keys().hasAll([
            'category',
            'availableListingCount',
            'updatedAt'
          ]) &&
          data.category == categoryId &&
          marketplaceValidCategory(data.category) &&
          data.availableListingCount is int &&
          data.availableListingCount >= 0 &&
          data.availableListingCount <= 1000000 &&
          data.updatedAt is timestamp;
    }

    function marketplaceValidAuditDetails(data) {
      return data is map &&
          data.keys().hasOnly([
            'reason',
            'role'
          ]) &&
          marketplaceValidOptionalString(data.get('reason', ''), 500) &&
          marketplaceValidOptionalString(data.get('role', ''), 30);
    }

    function marketplaceValidAdminAudit(data, eventId) {
      return data.keys().hasOnly([
            'actorUid',
            'action',
            'targetUid',
            'details',
            'createdAt'
          ]) &&
          data.keys().hasAll([
            'actorUid',
            'action',
            'targetUid',
            'details',
            'createdAt'
          ]) &&
          marketplaceValidId(eventId) &&
          marketplaceValidId(data.actorUid) &&
          marketplaceValidRequiredString(data.action, 1, 64) &&
          marketplaceValidId(data.targetUid) &&
          marketplaceValidAuditDetails(data.details) &&
          data.createdAt is timestamp;
    }

    //===================================================
    // ROOT ORIGINAL OWNER CAN UPDATE REPOST VISIBILITY
    //
    // Used when an original post is hidden/unhidden.
    //===================================================

    function isRootPostOwner() {
      let rootId =
          resource.data.get(
            'rootOriginalPostId',
            resource.data.get(
              'originalPostId',
              ''
            )
          );

      return isSignedIn() &&
          rootId != '' &&
          exists(
            /databases/$(database)/documents/posts/$(rootId)
          ) &&
          get(
            /databases/$(database)/documents/posts/$(rootId)
          ).data.uid == request.auth.uid;
    }

    //===================================================
    // POSTS
    //===================================================

    match /posts/{postId} {

      //===================================================
      // READ
      //
      // Client-side Nubify filtering currently handles:
      // isHidden
      // isRootHidden
      // blocked users
      //
      // Therefore authenticated users can query posts.
      //===================================================

      allow read: if isSignedIn();

      //===================================================
      // CREATE
      //
      // User can create only a post belonging to them.
      // This also applies to repost wrapper documents.
      //===================================================

      allow create: if isSignedIn() &&
          request.resource.data.uid ==
              request.auth.uid;

      //===================================================
      // UPDATE
      //
      // 1. OWNER CAN UPDATE THEIR OWN POST.
      //
      // But a repost owner cannot manually change
      // isRootHidden. That belongs to original owner.
      //
      // 2. USERS CAN UPDATE ENGAGEMENT FIELDS.
      //
      // 3. ORIGINAL OWNER CAN SYNC isRootHidden ON
      // OTHER USERS' REPOST WRAPPERS.
      //===================================================

      allow update: if isSignedIn() &&
          (
            (
              resource.data.uid ==
                  request.auth.uid &&
              !request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasAny([
                    'isRootHidden'
                  ])
            )

            ||

            changedOnly([
              'likeCount',
              'likedUserIds',
              'likes',
              'commentCount',
              'repostCount',
              'shareCount',
              'viewCount',
              'poll'
            ])

            ||

            (
              isRootPostOwner() &&
              changedOnly([
                'isRootHidden',
                'updatedAt'
              ])
            )
          );

      //===================================================
      // DELETE
      //===================================================

      allow delete: if isSignedIn() &&
          resource.data.uid ==
              request.auth.uid;

      //===================================================
      // POST LIKES
      //
      // posts/{postId}/likes/{uid}
      //===================================================

      match /likes/{likeUid} {

        allow read: if isSignedIn();

        allow create: if isCurrentUser(
              likeUid
            ) &&
            request.resource.data.uid ==
                request.auth.uid;

        allow delete: if isCurrentUser(
          likeUid
        );

        allow update: if false;
      }

      //===================================================
      // POST VIEWS
      //
      // ONE DOCUMENT PER USER
      //
      // posts/{postId}/views/{uid}
      //===================================================

      match /views/{viewerUid} {

        allow create: if isCurrentUser(
              viewerUid
            ) &&
            request.resource.data.uid ==
                request.auth.uid;

        //===================================================
        // USER CAN READ THEIR OWN VIEW.
        //
        // POST OWNER CAN ALSO READ VIEWERS.
        //===================================================

        allow read: if isSignedIn() &&
            (
              request.auth.uid ==
                  viewerUid

              ||

              (
                exists(
                  /databases/$(database)/documents/posts/$(postId)
                ) &&
                get(
                  /databases/$(database)/documents/posts/$(postId)
                ).data.uid ==
                    request.auth.uid
              )
            );

        allow update: if false;

        allow delete: if isCurrentUser(
          viewerUid
        );
      }

      //===================================================
      // COMMENTS
      //
      // posts/{postId}/comments/{commentId}
      //===================================================

      match /comments/{commentId} {

        allow read: if isSignedIn();

        //===================================================
        // CREATE COMMENT
        //===================================================

        allow create: if isSignedIn() &&
            request.resource.data.uid ==
                request.auth.uid;

        //===================================================
        // UPDATE
        //
        // Comment owner:
        // - text
        // - edit fields
        //
        // Other authenticated users:
        // - likeCount
        //
        // Reply creation/deletion:
        // - replyCount
        //===================================================

        allow update: if isSignedIn() &&
            (
              resource.data.uid ==
                  request.auth.uid

              ||

              changedOnly([
                'likeCount'
              ])

              ||

              changedOnly([
                'replyCount'
              ])
            );

        //===================================================
        // DELETE COMMENT
        //===================================================

        allow delete: if isSignedIn() &&
            resource.data.uid ==
                request.auth.uid;

        //===================================================
        // COMMENT LIKES
        //===================================================

        match /likes/{likeUid} {

          allow read: if isSignedIn();

          allow create: if isCurrentUser(
                likeUid
              ) &&
              request.resource.data.uid ==
                  request.auth.uid;

          allow delete: if isCurrentUser(
            likeUid
          );

          allow update: if false;
        }

        //===================================================
        // COMMENT REPLIES
        //===================================================

        match /replies/{replyId} {

          allow read: if isSignedIn();

          allow create: if isSignedIn() &&
              request.resource.data.uid ==
                  request.auth.uid;

          allow update: if isSignedIn() &&
              (
                resource.data.uid ==
                    request.auth.uid

                ||

                changedOnly([
                  'likeCount'
                ])
              );

          allow delete: if isSignedIn() &&
              resource.data.uid ==
                  request.auth.uid;

          //===================================================
          // REPLY LIKES
          //===================================================

          match /likes/{likeUid} {

            allow read: if isSignedIn();

            allow create: if isCurrentUser(
                  likeUid
                ) &&
                request.resource.data.uid ==
                    request.auth.uid;

            allow delete: if isCurrentUser(
              likeUid
            );

            allow update: if false;
          }
        }
      }
    }

    //===================================================
    // OLD GLOBAL COMMENTS
    //
    // Kept because your current CommentScreen still
    // contains compatibility logic for old Nubify data.
    //===================================================

    match /comments/{commentId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
          request.resource.data.uid ==
              request.auth.uid;

      allow update: if isSignedIn() &&
          (
            resource.data.uid ==
                request.auth.uid

            ||

            changedOnly([
              'likeCount',
              'replyCount'
            ])
          );

      allow delete: if isSignedIn() &&
          resource.data.uid ==
              request.auth.uid;

      match /replies/{replyId} {

        allow read: if isSignedIn();

        allow create: if isSignedIn() &&
            request.resource.data.uid ==
                request.auth.uid;

        allow update: if isSignedIn() &&
            (
              resource.data.uid ==
                  request.auth.uid

              ||

              changedOnly([
                'likeCount'
              ])
            );

        allow delete: if isSignedIn() &&
            resource.data.uid ==
                request.auth.uid;
      }
    }

    //===================================================
    // OLD GLOBAL REPLIES
    //===================================================

    match /replies/{replyId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
          request.resource.data.uid ==
              request.auth.uid;

      allow update: if isSignedIn() &&
          (
            resource.data.uid ==
                request.auth.uid

            ||

            changedOnly([
              'likeCount'
            ])
          );

      allow delete: if isSignedIn() &&
          resource.data.uid ==
              request.auth.uid;
    }

    //===================================================
    // USERS
    //===================================================

    match /users/{uid} {

      //===================================================
      // PROFILE IS VIEWABLE BY LOGGED-IN NUBIFY USERS
      //===================================================

      allow read: if isSignedIn();

      //===================================================
      // SIGNUP
      //===================================================

      allow create: if isCurrentUser(
        uid
      );

      //===================================================
      // PROFILE OWNER CAN UPDATE OWN PROFILE.
      //
      // Another authenticated user may change only the
      // target user's followers array. This is needed by
      // your current follow/unfollow transaction.
      //===================================================

      allow update: if isSignedIn() &&
          (
            request.auth.uid ==
                uid

            ||

            changedOnly([
              'followers'
            ])
          );

      allow delete: if isCurrentUser(
        uid
      );

      //===================================================
      // SAVED POSTS
      //
      // PRIVATE
      //===================================================

      match /savedPosts/{postId} {

        allow read,
              create,
              update,
              delete:
            if isCurrentUser(
              uid
            );
      }

      //===================================================
      // LIKED POSTS
      //
      // Profile -> Likes
      //
      // PRIVATE
      //===================================================

      match /likedPosts/{postId} {

        allow read,
              create,
              update,
              delete:
            if isCurrentUser(
              uid
            );
      }

      //===================================================
      // COMMENT ACTIVITY
      //
      // Profile -> Comments
      //
      // PRIVATE
      //===================================================

      match /commentActivity/{activityId} {

        allow read,
              create,
              update,
              delete:
            if isCurrentUser(
              uid
            );
      }

      //===================================================
      // HIDDEN POSTS
      //
      // Profile -> Hidden Posts
      //
      // PRIVATE
      //===================================================

      match /hiddenPosts/{postId} {

        allow read,
              create,
              update,
              delete:
            if isCurrentUser(
              uid
            );
      }

      //===================================================
      // BLOCKED USERS
      //
      // PRIVATE
      //===================================================

      match /blockedUsers/{blockedUid} {

        allow read,
              create,
              update,
              delete:
            if isCurrentUser(
              uid
            );
      }

      //===================================================
      // SAVED MARKETPLACE LISTINGS
      //
      // One document per user/listing pair prevents duplicate saves. The
      // saved marker remains private even if the product later becomes sold
      // or unavailable, so the app can display its changed availability.
      //===================================================

      match /savedMarketplaceListings/{listingId} {

        allow read: if isOwner(uid);

        allow create: if isOwner(uid) &&
            marketplaceValidSavedListing(
              request.resource.data,
              uid,
              listingId
            ) &&
            marketplaceSavedTargetIsPublic(listingId);

        allow update: if false;

        allow delete: if isOwner(uid) &&
            resource.data.ownerUid == uid &&
            resource.data.listingId == listingId;
      }
    }

    //===================================================
    // NUB MARKETPLACE LISTINGS
    //===================================================

    match /marketplaceProducts/{listingId} {

      // An individual document may be opened when it is publicly available,
      // belongs to the signed-in seller, or the caller is a trusted reviewer.
      // A user with a strictly owner-scoped save marker may also get that exact
      // canonical item after it becomes sold, unavailable, or archived. This
      // does not grant draft access and does not apply to collection queries.
      // A narrow legacy fallback keeps old shared links readable without
      // permitting unsafe legacy collection browsing.
      allow get: if isAuthenticated() &&
          (
            marketplaceIsPublicListing(resource.data) ||
            marketplaceListingOwner(resource.data) ||
            isMarketplaceReviewer() ||
            marketplaceIsSavedUnavailableListing(
              resource.data,
              listingId
            ) ||
            marketplaceIsLegacyPublicListing(resource.data)
          );

      // Public discovery queries must filter status == available and
      // publicVisible == true. Owner management queries must filter sellerId
      // to the caller. Review dashboards require a reviewer custom claim.
      allow list: if marketplaceHasSafeListLimit(50) &&
          (
            isMarketplaceReviewer() ||
            (
              isAuthenticated() &&
              (
                marketplaceIsPublicListing(resource.data) ||
                marketplaceListingOwner(resource.data)
              )
            )
          );

      allow create: if marketplaceValidListingCreate(
        request.resource.data,
        listingId
      );

      allow update: if marketplaceValidListingUpdate(
        request.resource.data,
        listingId
      );

      allow delete: if marketplaceListingOwner(resource.data) &&
          resource.data.listingId == listingId;
    }

    //===================================================
    // PRIVATE USER CONTACT DATA
    //===================================================

    match /userPrivate/{uid} {

      allow get: if isOwner(uid);

      allow list: if false;

      allow create: if marketplaceValidPrivateUserCreate(
        request.resource.data,
        uid
      );

      allow update: if marketplaceValidPrivateUserUpdate(
        request.resource.data,
        uid
      );

      allow delete: if isOwner(uid) &&
          resource.data.uid == uid;
    }

    //===================================================
    // SERVER-MAINTAINED PUBLIC MARKETPLACE STATISTICS
    //===================================================

    match /marketplaceSellerStats/{uid} {

      allow get: if isAuthenticated() &&
          marketplaceValidSellerStats(resource.data, uid);

      allow list: if isAuthenticated() &&
          marketplaceHasSafeListLimit(100);

      allow create, update, delete: if false;
    }

    match /marketplaceCategoryStats/{categoryId} {

      allow get: if isAuthenticated() &&
          marketplaceValidCategoryStats(
            resource.data,
            categoryId
          );

      // There are exactly twelve fixed category documents, but a generous
      // bounded limit keeps this rule compatible with future pagination.
      allow list: if isAuthenticated() &&
          marketplaceHasSafeListLimit(50);

      allow create, update, delete: if false;
    }

    //===================================================
    // MARKETPLACE REPORTING
    //===================================================

    match /marketplaceReports/{reportId} {

      allow create: if isAuthenticated() &&
          marketplaceValidReportCreate(
            request.resource.data,
            reportId
          );

      // The reporter may read an existing report they own. Before create,
      // reportListing() may also confirm that its own deterministic path does
      // not exist. No document data exists in that second branch to expose.
      allow get: if isAuthenticated() &&
          (
            isMarketplaceReviewer() ||
            (
              exists(
                /databases/$(database)/documents/marketplaceReports/$(reportId)
              ) &&
              resource.data.reporterId == request.auth.uid &&
              resource.data.reportId == reportId
            ) ||
            (
              !exists(
                /databases/$(database)/documents/marketplaceReports/$(reportId)
              ) &&
              marketplaceReportPathMatchesCaller(reportId)
            )
          );

      allow list: if isMarketplaceReviewer() &&
          marketplaceHasSafeListLimit(100);

      allow update: if marketplaceValidReportReview(
        request.resource.data,
        reportId
      );

      allow delete: if false;
    }

    //===================================================
    // MARKETPLACE ADMIN AUDIT LOG
    //
    // Writes are server-only. Firebase Admin SDK operations bypass client
    // rules and must validate marketplaceValidAdminAudit equivalently in the
    // trusted function before writing.
    //===================================================

    match /marketplaceAdminAudit/{eventId} {

      allow get: if isMarketplaceReviewer() &&
          marketplaceValidAdminAudit(resource.data, eventId);

      allow list: if isMarketplaceReviewer() &&
          marketplaceHasSafeListLimit(100);

      allow create, update, delete: if false;
    }

    // The ownership pointer is maintained only by the trusted ownership
    // transfer Cloud Function. Reviewer access supports the admin dashboard.
    match /marketplaceSystem/{documentId} {

      allow read: if isMarketplaceReviewer();

      allow create, update, delete: if false;
    }

    //===================================================
    // STORIES
    //===================================================

    match /stories/{storyId} {

      allow read: if isSignedIn();

      //===================================================
      // STORY CREATE
      //===================================================

      allow create: if isSignedIn() &&
          request.resource.data.uid ==
              request.auth.uid;

      //===================================================
      // STORY UPDATE
      //
      // OWNER CAN UPDATE THEIR STORY.
      //
      // OTHER USERS CAN UPDATE ONLY STORY ENGAGEMENT:
      //
      // viewerIds
      // viewCount
      // likedUserIds
      // likeCount
      // replyCount
      // poll
      // shareCount
      // reshareCount
      //===================================================

      allow update: if isSignedIn() &&
          (
            resource.data.uid ==
                request.auth.uid

            ||

            changedOnly([
              'viewerIds',
              'viewCount',
              'likedUserIds',
              'likeCount',
              'replyCount',
              'poll',
              'shareCount',
              'reshareCount'
            ])
          );

      //===================================================
      // STORY DELETE
      //===================================================

      allow delete: if isSignedIn() &&
          resource.data.uid ==
              request.auth.uid;

      //===================================================
      // STORY VIEWS
      //
      // Story owner can view viewer list.
      // Viewer can read their own viewer document.
      //===================================================

      match /views/{viewerUid} {

        allow create: if isCurrentUser(
              viewerUid
            ) &&
            request.resource.data.uid ==
                request.auth.uid;

        allow read: if isSignedIn() &&
            (
              request.auth.uid ==
                  viewerUid

              ||

              (
                exists(
                  /databases/$(database)/documents/stories/$(storyId)
                ) &&
                get(
                  /databases/$(database)/documents/stories/$(storyId)
                ).data.uid ==
                    request.auth.uid
              )
            );

        allow update: if false;

        allow delete: if isCurrentUser(
          viewerUid
        );
      }

      //===================================================
      // STORY REPLIES
      //===================================================

      match /replies/{replyId} {

        allow read: if isSignedIn();

        allow create: if isSignedIn() &&
            request.resource.data.uid ==
                request.auth.uid;

        allow update: if isSignedIn() &&
            resource.data.uid ==
                request.auth.uid;

        allow delete: if isSignedIn() &&
            resource.data.uid ==
                request.auth.uid;
      }
    }

    //===================================================
    // NOTIFICATIONS
    //
    // Supports BOTH notification field formats currently
    // present in Nubify:
    //
    // receiverId / senderId
    //
    // and
    //
    // uid / senderUid
    //===================================================

    match /notifications/{notificationId} {

      //===================================================
      // CREATE
      //===================================================

      allow create: if isSignedIn() &&
          (
            request.resource.data.get(
              'senderId',
              ''
            ) ==
                request.auth.uid

            ||

            request.resource.data.get(
              'senderUid',
              ''
            ) ==
                request.auth.uid
          );

      //===================================================
      // READ ONLY IF THIS NOTIFICATION BELONGS TO USER
      //===================================================

      allow read: if isSignedIn() &&
          (
            resource.data.get(
              'receiverId',
              ''
            ) ==
                request.auth.uid

            ||

            resource.data.get(
              'uid',
              ''
            ) ==
                request.auth.uid
          );

      //===================================================
      // RECEIVER CAN MARK READ
      //===================================================

      allow update: if isSignedIn() &&
          (
            resource.data.get(
              'receiverId',
              ''
            ) ==
                request.auth.uid

            ||

            resource.data.get(
              'uid',
              ''
            ) ==
                request.auth.uid
          );

      //===================================================
      // RECEIVER CAN DELETE
      //===================================================

      allow delete: if isSignedIn() &&
          (
            resource.data.get(
              'receiverId',
              ''
            ) ==
                request.auth.uid

            ||

            resource.data.get(
              'uid',
              ''
            ) ==
                request.auth.uid
          );
    }

    //===================================================
    // REPORTS
    //===================================================

    match /reports/{reportId} {

      //===================================================
      // ANY LOGGED-IN USER CAN SUBMIT REPORT
      //===================================================

      allow create: if isSignedIn();

      //===================================================
      // NORMAL USERS SHOULD NOT BROWSE OTHER REPORTS.
      //
      // This allows the reporter to read their own report
      // if you later add a "My Reports" screen.
      //===================================================

      allow read: if isSignedIn() &&
          (
            resource.data.get(
              'reportedBy',
              ''
            ) ==
                request.auth.uid
          );

      allow update,
            delete:
          if false;
    }

    //===================================================
    // CURRENT USER PROFILE ACTIVITY HISTORY
    //
    // ProfileActivityService uses collection-group
    // queries to find comments and replies written by
    // the signed-in user across every post location.
    // The uid filter in each query must match the user.
    //===================================================

    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn() &&
          resource.data.uid ==
              request.auth.uid;
    }

    match /{path=**}/replies/{replyId} {
      allow read: if isSignedIn() &&
          resource.data.uid ==
              request.auth.uid;
    }

    //===================================================
    // DENY UNKNOWN COLLECTIONS
    //===================================================

    match /{document=**} {
      allow read,
            write:
          if false;
    }
  }
}
