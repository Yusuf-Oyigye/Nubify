rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isMarketplaceMedia() {
      return request.resource != null && (
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('video/.*')
      );
    }

    //===================================================
    // MARKETPLACE PRODUCT MEDIA
    //===================================================

    match /marketplace/{uid}/{listingId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.size <= 30 * 1024 * 1024 &&
        isMarketplaceMedia();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    //===================================================
    // EXISTING NUBIFY MEDIA PATHS
    // These retain the access pattern used by the current app.
    //===================================================

    match /profilePics/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /posts/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /stories/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /chatMedia/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groupPhotos/{groupId}/{allPaths=**} {
      allow read, write: if signedIn();
    }

    match /comments/{postId}/{allPaths=**} {
      allow read, write: if signedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
