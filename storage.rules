
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    //===================================================
    // HELPER FUNCTIONS
    //===================================================

    function signedIn() {
      return request.auth != null;
    }

    function isMarketplaceMedia() {
      return request.resource != null && (
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('video/.*')
      );
    }

    //===================================================
    // MARKETPLACE PRODUCT MEDIA
    //===================================================

    match /marketplace/{uid}/{listingId}/{fileName} {

      allow read: if signedIn();

      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.size <= 30 * 1024 * 1024 &&
        isMarketplaceMedia();

      allow delete: if signedIn() &&
        request.auth.uid == uid;
    }

    //===================================================
    // NUBIFY PROFILE PICTURES
    //===================================================

    match /profilePics/{uid} {

      allow read: if signedIn();

      allow write: if signedIn() &&
        request.auth.uid == uid;
    }

    //===================================================
    // NUBIFY POSTS
    //===================================================

    match /posts/{uid}/{allPaths=**} {

      allow read: if signedIn();

      allow write: if signedIn() &&
        request.auth.uid == uid;
    }

    //===================================================
    // NUBIFY STORIES
    //===================================================

    match /stories/{uid}/{allPaths=**} {

      allow read: if signedIn();

      allow write: if signedIn() &&
        request.auth.uid == uid;
    }

    //===================================================
    // NUBIFY CHAT MEDIA
    //===================================================

    match /chatMedia/{uid}/{allPaths=**} {

      allow read: if signedIn();

      allow write: if signedIn() &&
        request.auth.uid == uid;
    }

    //===================================================
    // GROUP PROFILE PHOTOS
    //===================================================

    match /groupPhotos/{groupId}/{allPaths=**} {

      allow read, write: if signedIn();
    }

    //===================================================
    // COMMENT ATTACHMENTS
    //===================================================

    match /comments/{postId}/{allPaths=**} {

      allow read, write: if signedIn();
    }

    //===================================================
    // NUBIFY EGYPTIAN ARABIC
    // SHARED PRONUNCIATION AUDIO
    //===================================================

    match /egyptianArabicShared/{uid}/audio/{fileName} {

      // Every signed-in Nubify student
      // can listen to shared pronunciation.

      allow read: if signedIn();

      // All signed-in students can upload
      // audio to their own uploader folder.

      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.size <= 12 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');

      // Only the original uploader can
      // replace or delete the recording.

      allow update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.size <= 12 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');

      allow delete: if signedIn() &&
        request.auth.uid == uid;
    }

    //===================================================
    // DENY ALL OTHER STORAGE PATHS
    //===================================================

    match /{allPaths=**} {

      allow read, write: if false;
    }

  }
}
